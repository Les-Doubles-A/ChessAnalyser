{
  "name": "chessanalyser",
  "private": true,
  "version": "0.1.0",
  "description": "Analyse de parties chess.com dans le navigateur avec Stockfish",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "engine": "node scripts/copy-engine.mjs",
    "openings": "node scripts/build-openings.ts",
    "dataset:collect": "node --import ./scripts/ts-hooks.mjs scripts/collect-games.ts",
    "dataset:analyse": "node --import ./scripts/ts-hooks.mjs scripts/analyse-dataset.ts",
    "dataset:split": "node --import ./scripts/ts-hooks.mjs scripts/split-dataset.ts",
    "elo:calibrate": "node --import ./scripts/ts-hooks.mjs scripts/calibrate-elo.ts",
    "elo:validate": "node --import ./scripts/ts-hooks.mjs scripts/validate-elo.ts",
    "predev": "npm run engine",
    "dev": "vite",
    "prebuild": "npm run engine",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "vitest run --config vitest.engine.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run test:engine && npm run test:e2e"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "react": "19.3.1",
    "react-chessboard": "5.12.1",
    "react-dom": "19.3.1",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
